# --- Core ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sonora

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# --- Storage ---
# "local"  -> files saved under ./uploads (development, zero config)
# "cloudinary" -> files pushed to Cloudinary (production)
CLOUD_STORAGE_PROVIDER=local
CLOUD_STORAGE_NAME=
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_SECRET=
CLOUDINARY_FOLDER=sonora

# --- Upload limits ---
MAX_AUDIO_SIZE_MB=50
MAX_IMAGE_SIZE_MB=5

# --- Optional: defaults used by npm run create-admin ---
ADMIN_NAME=Sonora Admin
ADMIN_EMAIL=admin@sonora.dev
ADMIN_PASSWORD=admin1234
